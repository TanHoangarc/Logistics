{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and role information",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Manager", "Accountant"] },
        "email": { "type": "string", "format": "email" }
      },
      "required": ["username", "role"]
    },
    "Voucher": {
      "title": "Voucher",
      "description": "Shipping vouchers or price records",
      "type": "object",
      "properties": {
        "voucherNumber": { "type": "string" },
        "data": { "type": "object" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["voucherNumber", "createdBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered users in the system"
    },
    "/vouchers/{voucherId}": {
      "schema": "Voucher",
      "description": "Vouchers/Invoices created by users"
    }
  }
}

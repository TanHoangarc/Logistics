{
  "entities": {
    "Activity": {
      "title": "Activity",
      "description": "Log of recent activities in the system",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["submit", "approve", "settle", "other"] }
      },
      "required": ["timestamp", "content", "type"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Expense records for approval and settlement",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "submitter": { "type": "string" },
        "invoiceFile": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "isSettled": { "type": "boolean" }
      },
      "required": ["date", "type", "amount", "submitter", "isApproved", "isSettled"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Employee directory",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "position": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "line": { "type": "string" },
        "accountNumber": { "type": "string" },
        "bankName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["fullName", "position", "name", "email"]
    },
    "ExpenseCategory": {
      "title": "ExpenseCategory",
      "description": "Categories for expenses",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "Payee": {
      "title": "Payee",
      "description": "People who receive or pay money",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "DescriptionTemplate": {
      "title": "DescriptionTemplate",
      "description": "Predefined description content",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["receipt", "payment", "both"] }
      },
      "required": ["code", "content", "type"]
    },
    "CashTransaction": {
      "title": "CashTransaction",
      "description": "Daily cash journal entries",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "voucherNumber": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["receipt", "payment"] },
        "amount": { "type": "number" },
        "person": { "type": "string" }
      },
      "required": ["date", "voucherNumber", "description", "type", "amount"]
    },
    "KimberryJob": {
      "title": "KimberryJob",
      "description": "Freight and logistics jobs",
      "type": "object",
      "properties": {
        "monthYear": { "type": "string" },
        "job": { "type": "string" },
        "booking": { "type": "string" },
        "hbl": { "type": "string" },
        "line": { "type": "string" },
        "cont20": { "type": "number" },
        "cont40": { "type": "number" },
        "sell": { "type": "number" }
      },
      "required": ["monthYear", "job", "sell"]
    },
    "BankTransaction": {
      "title": "BankTransaction",
      "description": "Bank ledger entries",
      "type": "object",
      "properties": {
        "bank": { "type": "string", "enum": ["TCB", "MB"] },
        "date": { "type": "string", "format": "date" },
        "amount": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["bank", "date", "amount"]
    },
    "VatRecord": {
      "title": "VatRecord",
      "description": "VAT collection records",
      "type": "object",
      "properties": {
        "monthYear": { "type": "string" },
        "amount": { "type": "number" }
      },
      "required": ["monthYear", "amount"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily attendance logs",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "checkIn": { "type": "string" },
        "checkOut": { "type": "string" },
        "status": { "type": "string" },
        "note": { "type": "string" },
        "attachedFile": { "type": "string" }
      },
      "required": ["employeeId", "date"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Global system settings",
      "type": "object",
      "properties": {
        "initialBalanceDate": { "type": "string", "format": "date" },
        "initialBalanceAmount": { "type": "number" }
      }
    }
  },
  "firestore": {
    "activities": {
      "schema": "Activity",
      "description": "Global activity logs"
    },
    "expenses": {
      "schema": "Expense",
      "description": "All expense settlement requests"
    },
    "employees": {
      "schema": "Employee",
      "description": "Employee profile data"
    },
    "expenseCategories": {
      "schema": "ExpenseCategory",
      "description": "Manageable list of expense categories"
    },
    "payees": {
      "schema": "Payee",
      "description": "List of people for transactions"
    },
    "descriptionTemplates": {
      "schema": "DescriptionTemplate",
      "description": "Shortcuts for transaction descriptions"
    },
    "cashTransactions": {
      "schema": "CashTransaction",
      "description": "The daily cash book journal"
    },
    "kimberryJobs": {
      "schema": "KimberryJob",
      "description": "Logistics operations jobs"
    },
    "bankTransactions": {
      "schema": "BankTransaction",
      "description": "Bank ledger for multiple banks"
    },
    "vatRecords": {
      "schema": "VatRecord",
      "description": "VAT tracking records"
    },
    "attendance": {
      "schema": "AttendanceRecord",
      "description": "Time tracking and attendance"
    },
    "config/system": {
      "schema": "SystemConfig",
      "description": "Global parameters like initial balances"
    }
  }
}
